{
  "task_id": "cross_theme:invest_intangible",
  "task_type": "cross_theme",
  "objective": {
    "title": "Investment x Intangibles signal discovery",
    "description": "Discover symbolic equity-return signals that use both themes (investment and intangibles) for Investment x Intangibles. The signal should capture an interaction beyond an isolated single-theme effect. Economic story: Tangible and intangible investment can carry different return implications. The task is to compare physical expansion, R&D, goodwill, and intangible capital formation within investment signals."
  },
  "constraints": [
    {
      "kind": "must_use_theme",
      "value": "investment"
    },
    {
      "kind": "must_use_theme",
      "value": "intangibles"
    },
    {
      "kind": "exclude_financials",
      "value": "true"
    },
    {
      "kind": "exclude_microcap",
      "value": "true"
    }
  ],
  "output_schema": {
    "required_fields": [
      "name",
      "expression",
      "hypothesis",
      "expected_sign",
      "reasoning",
      "interaction_type"
    ],
    "allowed_expected_signs": [
      "positive",
      "negative"
    ],
    "allowed_interaction_types": [
      "composite",
      "conditional",
      "ratio",
      "novel"
    ]
  },
  "evaluation_protocol": {
    "evaluator_type": "signal_agent",
    "primary_metric": "fmb_tstat",
    "success_threshold": 1.96,
    "require_expected_sign_match": true,
    "alpha_factor_model": 5
  },
  "success_criteria": {
    "min_abs_tstat": 1.96,
    "require_expected_sign_match": true,
    "min_coverage": 0.0
  },
  "novelty_policy": {
    "reject_exact_expression_duplicates": true,
    "reject_normalized_expression_duplicates": true
  },
  "metadata": {
    "pair_name": "invest_intangible",
    "theme_a": "investment",
    "theme_b": "intangibles",
    "reference_library": "canonical_single_theme_reference",
    "interaction_label": "Investment x Intangibles",
    "economic_story": "Tangible and intangible investment can carry different return implications. The task is to compare physical expansion, R&D, goodwill, and intangible capital formation within investment signals.",
    "example_interactions": [
      "Intangible share of investment",
      "R&D growth versus asset growth",
      "Organic intangible investment",
      "Capex net of knowledge investment"
    ],
    "exclude_financials": true,
    "exclude_microcap": true,
    "sample_filters": [
      "exclude_financials",
      "exclude_microcap"
    ],
    "mode": "default",
    "seed_prompt": null,
    "guidance_scope": "none"
  }
