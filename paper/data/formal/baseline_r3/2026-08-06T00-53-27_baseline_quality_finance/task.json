{
  "task_id": "cross_theme:quality_finance",
  "task_type": "cross_theme",
  "objective": {
    "title": "Quality x Financing signal discovery",
    "description": "Discover symbolic equity-return signals that use both themes (quality and financing) for Quality x Financing. The signal should capture an interaction beyond an isolated single-theme effect. Economic story: Financing actions are more informative when paired with firm quality. Repurchases by high-quality firms may confirm undervaluation, while issuance by low-quality firms may confirm overvaluation or funding stress."
  },
  "constraints": [
    {
      "kind": "must_use_theme",
      "value": "quality"
    },
    {
      "kind": "must_use_theme",
      "value": "financing"
    },
    {
      "kind": "exclude_financials",
      "value": "true"
    },
    {
      "kind": "exclude_microcap",
      "value": "true"
    }
  ],
  "output_schema": {
    "required_fields": [
      "name",
      "expression",
      "hypothesis",
      "expected_sign",
      "reasoning",
      "interaction_type"
    ],
    "allowed_expected_signs": [
      "positive",
      "negative"
    ],
    "allowed_interaction_types": [
      "composite",
      "conditional",
      "ratio",
      "novel"
    ]
  },
  "evaluation_protocol": {
    "evaluator_type": "signal_agent",
    "primary_metric": "fmb_tstat",
    "success_threshold": 1.96,
    "require_expected_sign_match": true,
    "alpha_factor_model": 5
  },
  "success_criteria": {
    "min_abs_tstat": 1.96,
    "require_expected_sign_match": true,
    "min_coverage": 0.0
  },
  "novelty_policy": {
    "reject_exact_expression_duplicates": true,
    "reject_normalized_expression_duplicates": true
  },
  "metadata": {
    "pair_name": "quality_finance",
    "theme_a": "quality",
    "theme_b": "financing",
    "reference_library": "canonical_single_theme_reference",
    "interaction_label": "Quality x Financing",
    "economic_story": "Financing actions are more informative when paired with firm quality. Repurchases by high-quality firms may confirm undervaluation, while issuance by low-quality firms may confirm overvaluation or funding stress.",
    "example_interactions": [
      "Quality repurchaser",
      "Low-quality issuer penalty",
      "Payout quality composite",
      "Stable cash-flow financing signal"
    ],
    "exclude_financials": true,
    "exclude_microcap": true,
    "sample_filters": [
      "exclude_financials",
      "exclude_microcap"
    ],
    "mode": "default",
    "seed_prompt": null,
    "guidance_scope": "none"
  }
}