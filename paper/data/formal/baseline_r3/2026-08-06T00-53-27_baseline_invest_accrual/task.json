{
  "task_id": "cross_theme:invest_accrual",
  "task_type": "cross_theme",
  "objective": {
    "title": "Investment x Accruals signal discovery",
    "description": "Discover symbolic equity-return signals that use both themes (investment and accruals) for Investment x Accruals. The signal should capture an interaction beyond an isolated single-theme effect. Economic story: Asset growth driven by accruals can reverse differently from growth driven by real investment. The task is to distinguish accounting growth from productive investment."
  },
  "constraints": [
    {
      "kind": "must_use_theme",
      "value": "investment"
    },
    {
      "kind": "must_use_theme",
      "value": "accruals"
    },
    {
      "kind": "exclude_financials",
      "value": "true"
    },
    {
      "kind": "exclude_microcap",
      "value": "true"
    }
  ],
  "output_schema": {
    "required_fields": [
      "name",
      "expression",
      "hypothesis",
      "expected_sign",
      "reasoning",
      "interaction_type"
    ],
    "allowed_expected_signs": [
      "positive",
      "negative"
    ],
    "allowed_interaction_types": [
      "composite",
      "conditional",
      "ratio",
      "novel"
    ]
  },
  "evaluation_protocol": {
    "evaluator_type": "signal_agent",
    "primary_metric": "fmb_tstat",
    "success_threshold": 1.96,
    "require_expected_sign_match": true,
    "alpha_factor_model": 5
  },
  "success_criteria": {
    "min_abs_tstat": 1.96,
    "require_expected_sign_match": true,
    "min_coverage": 0.0
  },
  "novelty_policy": {
    "reject_exact_expression_duplicates": true,
    "reject_normalized_expression_duplicates": true
  },
  "metadata": {
    "pair_name": "invest_accrual",
    "theme_a": "investment",
    "theme_b": "accruals",
    "reference_library": "canonical_single_theme_reference",
    "interaction_label": "Investment x Accruals",
    "economic_story": "Asset growth driven by accruals can reverse differently from growth driven by real investment. The task is to distinguish accounting growth from productive investment.",
    "example_interactions": [
      "Real versus accounting growth",
      "Working capital growth",
      "Tangible investment share",
      "Accrual-adjusted investment"
    ],
    "exclude_financials": true,
    "exclude_microcap": true,
    "sample_filters": [
      "exclude_financials",
      "exclude_microcap"
    ],
    "mode": "default",
    "seed_prompt": null,
    "guidance_scope": "none"
  }
}