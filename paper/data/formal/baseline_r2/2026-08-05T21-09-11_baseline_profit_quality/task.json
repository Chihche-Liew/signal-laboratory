{
  "task_id": "cross_theme:profit_quality",
  "task_type": "cross_theme",
  "objective": {
    "title": "Profitability x Quality signal discovery",
    "description": "Discover symbolic equity-return signals that use both themes (profitability and quality) for Profitability x Quality. The signal should capture an interaction beyond an isolated single-theme effect. Economic story: High profitability is more valuable when it is stable, persistent, and financially healthy. The task is to distinguish durable operating strength from transient or levered profitability."
