{
  "task_id": "cross_theme:value_intangible",
  "task_type": "cross_theme",
  "objective": {
    "title": "Valuation x Intangibles signal discovery",
    "description": "Discover symbolic equity-return signals that use both themes (valuation and intangibles) for Valuation x Intangibles. The signal should capture an interaction beyond an isolated single-theme effect. Economic story: Accounting can understate book value for intangible-intensive firms, making standard valuation ratios noisy. The task is to find value signals that account for intangible investment and intangible asset productivity."
  },
  "constraints": [
    {
      "kind": "must_use_theme",
      "value": "valuation"
    },
    {
      "kind": "must_use_theme",
      "value": "intangibles"
    },
    {
      "kind": "exclude_financials",
      "value": "true"
    },
    {
      "kind": "exclude_microcap",
      "value": "true"
    }
  ],
  "output_schema": {
