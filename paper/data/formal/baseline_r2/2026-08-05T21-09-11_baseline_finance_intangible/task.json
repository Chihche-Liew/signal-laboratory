{
  "task_id": "cross_theme:finance_intangible",
  "task_type": "cross_theme",
  "objective": {
    "title": "Financing x Intangibles signal discovery",
    "description": "Discover symbolic equity-return signals that use both themes (financing and intangibles) for Financing x Intangibles. The signal should capture an interaction beyond an isolated single-theme effect. Economic story: External financing for intangible investment can indicate valuable innovation funding or market-timed issuance. The task is to distinguish productive intangible financing from overvaluation-driven issuance."
  },
  "constraints": [
    {
      "kind": "must_use_theme",
      "value": "financing"
    },
    {
      "kind": "must_use_theme",
      "value": "intangibles"
    },
    {
      "kind": "exclude_financials",
      "value": "true"
    },
    {
      "kind": "exclude_microcap",
      "value": "true"
    }
  ],
  "output_schema": {
    "required_fields": [
      "name",
      "expression",
      "hypothesis",
      "expected_sign",
      "reasoning",
      "interaction_type"
    ],
    "allowed_expected_signs": [
      "positive",
      "negative"
    ],
    "allowed_interaction_types": [
      "composite",
      "conditional",
      "ratio",
      "novel"
    ]
  },
  "evaluation_protocol": {
    "evaluator_type": "signal_agent",
    "primary_metric": "fmb_tstat",
    "success_threshold": 1.96,
    "require_expected_sign_match": true,
    "alpha_factor_model": 5
  },
  "success_criteria": {
    "min_abs_tstat": 1.96,
    "require_expected_sign_match": true,
    "min_coverage": 0.0
  },
  "novelty_policy": {
    "reject_exact_expression_duplicates": true,
    "reject_normalized_expression_duplicates": true
  },
  "metadata": {
    "pair_name": "finance_intangible",
    "theme_a": "financing",
    "theme_b": "intangibles",
    "reference_library": "canonical_single_theme_reference",
    "interaction_label": "Financing x Intangibles",
    "economic_story": "External financing for intangible investment can indicate valuable innovation funding or market-timed issuance. The task is to distinguish productive intangible financing from overvaluation-driven issuance.",
    "example_interactions": [
      "Externally funded R&D growth",
      "Repurchase-backed intangible value",
      "Issuance-adjusted knowledge capital",
      "Organic versus financed intangible investment"
    ],
    "exclude_financials": true,
    "exclude_microcap": true,
    "sample_filters": [
      "exclude_financials",
      "exclude_microcap"
    ],
    "mode": "default",
