{
  "task_id": "cross_theme:value_finance",
  "task_type": "cross_theme",
  "objective": {
    "title": "Valuation x Financing signal discovery",
    "description": "Discover symbolic equity-return signals that use both themes (valuation and financing) for Valuation x Financing. The signal should capture an interaction beyond an isolated single-theme effect. Economic story: Cheap firms where management repurchases shares may reveal stronger undervaluation, while expensive firms issuing equity may reveal overvaluation. The task is to combine market valuation with financing behavior."
  },
  "constraints": [
    {
      "kind": "must_use_theme",
      "value": "valuation"
    },
    {
      "kind": "must_use_theme",
      "value": "financing"
    },
    {
      "kind": "exclude_financials",
      "value": "true"
    },
    {
      "kind": "exclude_microcap",
      "value": "true"
    }
  ],
  "output_schema": {
    "required_fields": [
      "name",
      "expression",
      "hypothesis",
      "expected_sign",
      "reasoning",
      "interaction_type"
    ],
    "allowed_expected_signs": [
      "positive",
      "negative"
    ],
    "allowed_interaction_types": [
      "composite",
      "conditional",
      "ratio",
      "novel"
    ]
  },
  "evaluation_protocol": {
    "evaluator_type": "signal_agent",
    "primary_metric": "fmb_tstat",
    "success_threshold": 1.96,
    "require_expected_sign_match": true,
    "alpha_factor_model": 5
  },
  "success_criteria": {
    "min_abs_tstat": 1.96,
    "require_expected_sign_match": true,
    "min_coverage": 0.0
  },
  "novelty_policy": {
    "reject_exact_expression_duplicates": true,
    "reject_normalized_expression_duplicates": true
  },
  "metadata": {
    "pair_name": "value_finance",
    "theme_a": "valuation",
    "theme_b": "financing",
    "reference_library": "canonical_single_theme_reference",
    "interaction_label": "Valuation x Financing",
    "economic_story": "Cheap firms where management repurchases shares may reveal stronger undervaluation, while expensive firms issuing equity may reveal overvaluation. The task is to combine market valuation with financing behavior.",
    "example_interactions": [
      "Conviction value",
      "Buyback yield for value stocks",
      "Management-confirmed cheapness",
      "Issuance-adjusted valuation"
    ],
    "exclude_financials": true,
    "exclude_microcap": true,
    "sample_filters": [
      "exclude_financials",
      "exclude_microcap"
