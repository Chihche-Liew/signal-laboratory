{
  "task_id": "cross_theme:accrual_quality",
  "task_type": "cross_theme",
  "objective": {
    "title": "Accruals x Quality signal discovery",
    "description": "Discover symbolic equity-return signals that use both themes (accruals and quality) for Accruals x Quality. The signal should capture an interaction beyond an isolated single-theme effect. Economic story: Low accruals combined with persistent, stable earnings should identify genuinely cash-backed reported performance. The task is to distinguish durable cash earnings from accounting noise."
  },
  "constraints": [
    {
      "kind": "must_use_theme",
      "value": "accruals"
    },
    {
      "kind": "must_use_theme",
      "value": "quality"
    },
    {
      "kind": "exclude_financials",
      "value": "true"
    },
    {
      "kind": "exclude_microcap",
      "value": "true"
    }
  ],
  "output_schema": {
