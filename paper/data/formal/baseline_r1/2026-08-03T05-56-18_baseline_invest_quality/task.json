{
  "task_id": "cross_theme:invest_quality",
  "task_type": "cross_theme",
  "objective": {
    "title": "Investment x Quality signal discovery",
    "description": "Discover symbolic equity-return signals that use both themes (investment and quality) for Investment x Quality. The signal should capture an interaction beyond an isolated single-theme effect. Economic story: Investment is more informative when paired with quality: disciplined investment by high-quality firms may differ from asset growth by fragile firms. The task is to distinguish productive investment from low-quality expansion."
  },
  "constraints": [
    {
      "kind": "must_use_theme",
      "value": "investment"
    },
    {
      "kind": "must_use_theme",
      "value": "quality"
    },
    {
      "kind": "exclude_financials",
      "value": "true"
    },
    {
      "kind": "exclude_microcap",
      "value": "true"
    }
  ],
  "output_schema": {
    "required_fields": [
      "name",
      "expression",
      "hypothesis",
      "expected_sign",
      "reasoning",
      "interaction_type"
    ],
    "allowed_expected_signs": [
      "positive",
      "negative"
    ],
    "allowed_interaction_types": [
      "composite",
      "conditional",
      "ratio",
      "novel"
    ]
  },
  "evaluation_protocol": {
    "evaluator_type": "signal_agent",
    "primary_metric": "fmb_tstat",
    "success_threshold": 1.96,
    "require_expected_sign_match": true,
    "alpha_factor_model": 5
  },
  "success_criteria": {
    "min_abs_tstat": 1.96,
    "require_expected_sign_match": true,
    "min_coverage": 0.0
  },
  "novelty_policy": {
    "reject_exact_expression_duplicates": true,
    "reject_normalized_expression_duplicates": true
  },
  "metadata": {
    "pair_name": "invest_quality",
    "theme_a": "investment",
    "theme_b": "quality",
    "reference_library": "canonical_single_theme_reference",
    "interaction_label": "Investment x Quality",
    "economic_story": "Investment is more informative when paired with quality: disciplined investment by high-quality firms may differ from asset growth by fragile firms. The task is to distinguish productive investment from low-quality expansion.",
    "example_interactions": [
      "Quality-adjusted asset growth",
      "Stable earnings with low investment",
      "Productive capex composite",
      "Low-quality growth penalty"
    ],
    "exclude_financials": true,
    "exclude_microcap": true,
    "sample_filters": [
      "exclude_financials",
      "exclude_microcap"
    ],
    "mode": "default",
    "seed_prompt": null,
    "guidance_scope": "none"
  }
}